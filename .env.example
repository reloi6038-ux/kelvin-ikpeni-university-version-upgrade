# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development
PORT=5000

# ======================
# DATABASE
# ======================
# mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/kiu?retryWrites=true&w=majority
MONGODB_URI=

# ======================
# JWT / COOKIES
# ======================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# ======================
# CORS
# Comma-separated list of allowed origins.
# In production, use: https://kelvin-ikpeni-university.onrender.com
# ======================
ALLOWED_ORIGINS=http://localhost:5000

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ======================
# ADMIN SEED (used only by scripts/seed.js)
# ======================
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=